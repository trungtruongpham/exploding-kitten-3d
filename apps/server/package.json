{
  "name": "@meobom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:socket.io --outfile=dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@meobom/engine": "0.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0",
    "vitest": "^2.1.5"
  }
}
